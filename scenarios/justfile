# Escenarios de la línea de comandos.
#
#   just                 lista lo disponible
#   just test-03         ejecuta un escenario
#   just todos           ejecuta los 25 y resume
#   just construir        compila el binario que se prueba

set shell := ["bash", "-euo", "pipefail", "-c"]

escenario := justfile_directory() / "escenario.sh"

# Compila el binario que se prueba.
construir:
    @cd "{{ justfile_directory() / '..' }}" && cargo build --quiet
    @echo "binario listo"

# Ejecuta un escenario. El número va suelto: `just 03`.
escenario numero:
    @bash "{{ escenario }}" "{{ numero }}"

# Ejecuta todos y resume cuántos fallaron.
todos: construir
    @fallos=0; \
    for n in $(seq -w 1 25); do \
        bash "{{ escenario }}" "$n" || fallos=$((fallos + 1)); \
    done; \
    echo; \
    if [ "$fallos" -eq 0 ]; then \
        echo "Los 25 escenarios se comportaron como se esperaba."; \
    else \
        echo "$fallos escenario(s) con diferencias."; \
    fi

test-01: construir
    @bash "{{ escenario }}" 01

test-02: construir
    @bash "{{ escenario }}" 02

test-03: construir
    @bash "{{ escenario }}" 03

